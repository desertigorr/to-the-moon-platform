# Official organizer emulator. Copy to .env only to override defaults.
DATA_MODE=emulator_replay
SCENARIO_DATASET_DIR=/app/dataset/validate
SCENARIO_START=2026-01-06T12:30:00Z
SCENARIO_DURATION_S=1800
SCENARIO_TICK_S=1
GEOMETRY_PATH=assets/geometry.json
# For the organizer's random generator alone: DATA_MODE=emulator
EMULATOR_API_PORT=18080
EMULATOR_INTERVAL_MS=5000
NDTP_MAPPING=examples/emulator-unit-map.json
FRONTEND_PORT=8080
API_PORT=8000
NDTP_PUBLIC_PORT=9201
ML_INTERVAL_S=5
STALE_AFTER_S=30
# Per-device upper bound and retention; retain at least 10 minutes for ML.
HISTORY_SIZE=10000
HISTORY_SECONDS=900
FRONTEND_BIND=127.0.0.1
NDTP_BIND=127.0.0.1
# Live mode: paths INSIDE the container; dataset is mounted at /app/dataset.
# DATA_MODE=live
# SCHEDULE_PATH=/app/dataset/current-schedule.csv
# NDTP_MAPPING=/app/dataset/unit-map.json
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173
